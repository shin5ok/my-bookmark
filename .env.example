# Copy to .env. This file uses shell syntax; quote values when necessary.
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
GOOGLE_CLOUD_PROJECT=demo-bookmark
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LOCATION=global

# Deployment: a billing-enabled Google Cloud project (not demo-bookmark)
PROJECT_ID=
REGION=asia-northeast1
SERVICE=shiori
# Set a custom domain only if it is already routed to the service.
# DEPLOY_BASE_URL=https://your-domain.example

# API専用サービスではtrue。通常の画面用サービスはfalse。
API_ONLY=false
# 本番はdeploy.shがAPI専用Cloud RunサービスのURLを設定します。
# ローカル開発では空ならBASE_URLを使用します。
API_BASE_URL=

# 本番はdeploy.shが設定。ローカルでは空欄でFirestoreの待機ジョブを直接実行。
WORKER_ONLY=false
TASKS_QUEUE=
TASKS_WORKER_URL=
TASKS_SERVICE_ACCOUNT=
