# Copy to .env. This file uses shell syntax; quote values when necessary.
APP_ENV=development
PORT=8080
BASE_URL=http://localhost:8080
GOOGLE_CLOUD_PROJECT=demo-bookmark
FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Deployment: a billing-enabled Google Cloud project (not demo-bookmark)
PROJECT_ID=
REGION=asia-northeast1
SERVICE=shiori
# Set a custom domain only if it is already routed to the service.
# DEPLOY_BASE_URL=https://your-domain.example
